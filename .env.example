# Copy to .env and adjust for your host. .env is ignored by git.

# Docker image (default: the one published on GitHub Container Registry)
# MYGARAGE_IMAGE=ghcr.io/canada87/mygarage:latest

# Host port the web UI is exposed on
MYGARAGE_PORT=8080

# URL used in email links and calendar invites
MYGARAGE_BASE_URL=http://localhost:8080

# SQLite database and settings: keep on a local disk, not on a network share
MYGARAGE_DATA_DIR=./data

# Uploaded documents (invoices, registration, policies): can live on a NAS
MYGARAGE_DOCS_DIR=./documents

TZ=Europe/Rome
